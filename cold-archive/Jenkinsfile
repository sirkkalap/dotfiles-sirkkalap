pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
  }

  environment {
    COLD_ARCHIVE_JUNIT_OUT = 'artifacts/selftest.xml'
  }

  stages {
    stage('Self-test (Python runner)') {
      steps {
        // Synkataan bind-mountattu lähde workspaceen (workspace on jenkins_home-volumen alla ja kirjoitettava)
        sh 'rsync -a --delete --exclude=.git/ /src/ ./'

        sh 'mkdir -p artifacts'
        sh './scripts/ci-selftest.sh'
      }
      post {
        always {
          sh 'ls -la artifacts || true; test -s artifacts/selftest.xml'
          junit testResults: 'artifacts/selftest.xml', allowEmptyResults: false
          archiveArtifacts artifacts: 'artifacts/**', fingerprint: true
        }
      }
    }
  }
}
